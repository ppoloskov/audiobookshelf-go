{
  "name": "auth-lifecycle",
  "steps": [
    {
      "name": "status-unauthenticated",
      "method": "GET",
      "path": "/status",
      "expect_status": 200
    },
    {
      "name": "login-web-root",
      "method": "POST",
      "path": "/login",
      "body": {"username": "trial-root", "password": "trial-root-password"},
      "expect_status": 200,
      "capture": {"root_access": "user.accessToken"}
    },
    {
      "name": "login-bad-password",
      "method": "POST",
      "path": "/login",
      "body": {"username": "trial-root", "password": "wrong-password"},
      "expect_status": 401
    },
    {
      "name": "authorize-root",
      "method": "POST",
      "path": "/api/authorize",
      "role": "root",
      "expect_status": 200
    },
    {
      "name": "me-listener",
      "method": "GET",
      "path": "/api/me",
      "role": "listener",
      "expect_status": 200
    },
    {
      "name": "create-user-and-check-db",
      "method": "POST",
      "path": "/api/users",
      "role": "root",
      "body": {
        "username": "oracle-temp-user",
        "password": "temp-password-123",
        "type": "user",
        "isActive": true,
        "permissions": {"download": true, "update": false, "delete": false, "upload": false, "accessAllLibraries": true, "accessAllTags": true, "accessExplicitContent": true}
      },
      "expect_status": 200,
      "capture": {"temp_user_id": "user.id"},
      "check_db": true,
      "check_sockets": true
    },
    {
      "name": "login-new-user",
      "method": "POST",
      "path": "/login",
      "header": {"x-return-tokens": "true"},
      "body": {"username": "oracle-temp-user", "password": "temp-password-123"},
      "expect_status": 200,
      "capture": {
        "temp_access": "user.accessToken",
        "temp_refresh": "user.refreshToken"
      }
    },
    {
      "name": "refresh-new-user-token",
      "method": "POST",
      "path": "/auth/refresh",
      "header": {"x-refresh-token": "{{temp_refresh}}"},
      "expect_status": 200,
      "capture": {
        "temp_access2": "user.accessToken",
        "temp_refresh2": "user.refreshToken"
      }
    },
    {
      "name": "logout-new-user",
      "method": "POST",
      "path": "/logout",
      "role": "{{temp_access2}}",
      "header": {"x-refresh-token": "{{temp_refresh2}}"},
      "expect_status": 200
    },
    {
      "name": "refresh-after-logout-rejected",
      "method": "POST",
      "path": "/auth/refresh",
      "header": {"x-refresh-token": "{{temp_refresh2}}"},
      "expect_status": 401
    },
    {
      "name": "deactivate-user",
      "method": "PATCH",
      "path": "/api/users/{{temp_user_id}}",
      "role": "root",
      "body": {"isActive": false},
      "expect_status": 200,
      "check_db": true,
      "check_sockets": true
    },
    {
      "name": "inactive-user-login-denied",
      "method": "POST",
      "path": "/login",
      "body": {"username": "oracle-temp-user", "password": "temp-password-123"},
      "expect_status": 401
    },
    {
      "name": "delete-temp-user",
      "method": "DELETE",
      "path": "/api/users/{{temp_user_id}}",
      "role": "root",
      "expect_status": 200,
      "check_db": true,
      "check_sockets": true
    }
  ]
}
