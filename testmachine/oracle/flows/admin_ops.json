{
  "name": "admin-ops-settings-backups-mail-notify",
  "steps": [
    {"name": "patch-server-settings", "method": "PATCH", "path": "/api/settings", "role": "root", "body": {"dateFormat": "yyyy-MM-dd", "timeFormat": "HH:mm", "backupsToKeep": 3}, "expect_status": 200, "check_db": true},
    {"name": "patch-sorting-prefixes", "method": "PATCH", "path": "/api/sorting-prefixes", "role": "root", "body": {"sortingPrefixes": ["the", "a", "an"]}, "expect_status": 200, "check_db": true},
    {"name": "get-auth-settings", "method": "GET", "path": "/api/auth-settings", "role": "root", "expect_status": 200},
    {"name": "patch-auth-settings", "method": "PATCH", "path": "/api/auth-settings", "role": "root", "body": {"authLoginCustomMessage": "Oracle Twin Verification"}, "expect_status": 200, "check_db": true},
    {"name": "seed-tags-and-genres-on-saga1", "method": "PATCH", "path": "/api/items/{{saga1}}/media", "role": "root", "body": {"tags": ["alpha-tag", "beta-tag"], "metadata": {"genres": ["Fiction", "Sci-Fi"]}}, "expect_status": 200, "check_db": true},
    {"name": "get-tags", "method": "GET", "path": "/api/tags", "role": "root", "expect_status": 200},
    {"name": "rename-tag", "method": "POST", "path": "/api/tags/rename", "role": "root", "body": {"tag": "alpha-tag", "newTag": "gamma-tag"}, "expect_status": 200, "check_db": true},
    {"name": "delete-tag", "method": "DELETE", "path": "/api/tags/Z2FtbWEtdGFn", "role": "root", "expect_status": 200, "check_db": true},
    {"name": "get-genres", "method": "GET", "path": "/api/genres", "role": "root", "expect_status": 200},
    {"name": "rename-genre", "method": "POST", "path": "/api/genres/rename", "role": "root", "body": {"genre": "Sci-Fi", "newGenre": "Speculative"}, "expect_status": 200, "check_db": true},
    {"name": "delete-genre", "method": "DELETE", "path": "/api/genres/U3BlY3VsYXRpdmU=", "role": "root", "expect_status": 200, "check_db": true},
    {"name": "get-library-folder-path", "method": "GET", "path": "/api/libraries/{{library}}", "role": "root", "expect_status": 200, "capture": {"lib_folder_path": "folders.0.fullPath"}},
    {"name": "get-filesystem", "method": "GET", "path": "/api/filesystem", "role": "root", "query": {"path": "{{media}}", "level": "0"}, "expect_status": 200},
    {"name": "post-filesystem-pathexists", "method": "POST", "path": "/api/filesystem/pathexists", "role": "root", "body": {"directory": "nonexistent-oracle-dir", "folderPath": "{{lib_folder_path}}"}, "expect_status": 200},
    {"name": "validate-cron", "method": "POST", "path": "/api/validate-cron", "role": "root", "body": {"expression": "0 3 * * *"}, "expect_status": 200},
    {"name": "stats-server", "method": "GET", "path": "/api/stats/server", "role": "root", "expect_status": 200},
    {"name": "stats-year-2026", "method": "GET", "path": "/api/stats/year/2026", "role": "root", "expect_status": 200},
    {"name": "get-logger-data", "method": "GET", "path": "/api/logger-data", "role": "root", "expect_status": 200},
    {"name": "get-tasks", "method": "GET", "path": "/api/tasks", "role": "root", "expect_status": 200},
    {"name": "cache-purge", "method": "POST", "path": "/api/cache/purge", "role": "root", "expect_status": 200},
    {"name": "cache-items-purge", "method": "POST", "path": "/api/cache/items/purge", "role": "root", "expect_status": 200},
    {"name": "backups-list", "method": "GET", "path": "/api/backups", "role": "root", "expect_status": 200},
    {"name": "backups-create", "method": "POST", "path": "/api/backups", "role": "root", "expect_status": 200, "capture": {"backup_id": "backups.0.id"}},
    {"name": "backups-download", "method": "GET", "path": "/api/backups/{{backup_id}}/download", "role": "root", "expect_status": 200},
    {"name": "backups-delete", "method": "DELETE", "path": "/api/backups/{{backup_id}}", "role": "root", "expect_status": 200},
    {"name": "emails-get-settings", "method": "GET", "path": "/api/emails/settings", "role": "root", "expect_status": 200},
    {
      "name": "emails-patch-settings",
      "method": "PATCH",
      "path": "/api/emails/settings",
      "role": "root",
      "body": {"host": "{{stub_smtp_host}}", "port": "{{stub_smtp_port}}", "secure": false, "rejectUnauthorized": false, "fromAddress": "abs@example.test", "testAddress": "test@example.test"},
      "expect_status": 200,
      "check_db": true
    },
    {
      "name": "emails-ereader-devices",
      "method": "POST",
      "path": "/api/emails/ereader-devices",
      "role": "root",
      "body": {"ereaderDevices": [{"name": "Kindle Oracle", "email": "kindle@example.test", "availabilityOption": "adminOrUp", "users": []}]},
      "expect_status": 200,
      "check_db": true,
      "check_sockets": true
    },
    {"name": "emails-send-test", "method": "POST", "path": "/api/emails/test", "role": "root", "expect_status": 200, "check_stubs": true},
    {"name": "notifications-get", "method": "GET", "path": "/api/notifications", "role": "root", "expect_status": 200},
    {"name": "notificationdata-get", "method": "GET", "path": "/api/notificationdata", "role": "root", "expect_status": 200},
    {"name": "stub-apprise-route", "kind": "stub_route", "path": "/apprise", "stub_status": 200, "stub_content_type": "application/json", "stub_body": "{\"ok\":true}"},
    {"name": "notifications-patch-settings", "method": "PATCH", "path": "/api/notifications", "role": "root", "body": {"appriseApiUrl": "{{stub_http}}/apprise", "maxFailedAttempts": 5, "maxNotificationQueue": 20}, "expect_status": 200, "check_db": true},
    {
      "name": "notifications-create",
      "method": "POST",
      "path": "/api/notifications",
      "role": "root",
      "body": {"eventName": "onTest", "urls": ["mailto://user:pass@example.com"], "titleTemplate": "ABS Alert", "bodyTemplate": "Test notification body", "enabled": true, "type": "info"},
      "expect_status": 200,
      "capture": {"notif_id": "notifications.0.id"},
      "check_db": true
    },
    {
      "name": "notifications-patch-one",
      "method": "PATCH",
      "path": "/api/notifications/{{notif_id}}",
      "role": "root",
      "body": {"id": "{{notif_id}}", "eventName": "onTest", "urls": ["mailto://user:pass@example.com"], "titleTemplate": "ABS Alert Updated", "bodyTemplate": "Updated notification body", "enabled": true, "type": "info"},
      "expect_status": 200,
      "check_db": true
    },
    {"name": "notifications-send-test", "method": "GET", "path": "/api/notifications/{{notif_id}}/test", "role": "root", "expect_status": 200, "check_stubs": true},
    {"name": "notifications-delete", "method": "DELETE", "path": "/api/notifications/{{notif_id}}", "role": "root", "expect_status": 200, "check_db": true},
    {"name": "custom-providers-list", "method": "GET", "path": "/api/custom-metadata-providers", "role": "root", "expect_status": 200},
    {
      "name": "custom-providers-create",
      "method": "POST",
      "path": "/api/custom-metadata-providers",
      "role": "root",
      "body": {"name": "Oracle Books Provider", "url": "https://provider.example.com/", "mediaType": "book", "authHeaderValue": "Bearer oracle-token"},
      "expect_status": 200,
      "capture": {"prov_id": "provider.id"},
      "check_db": true,
      "check_sockets": true
    },
    {"name": "custom-providers-delete", "method": "DELETE", "path": "/api/custom-metadata-providers/{{prov_id}}", "role": "root", "expect_status": 200, "check_db": true, "check_sockets": true}
  ]
}
