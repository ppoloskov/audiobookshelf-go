  "normalization": [
    { "case": "login, refresh, reader-login", "field": "user.accessToken", "type": "string token, at least 10 characters", "required": true },
    { "case": "login, refresh, reader-login", "field": "user.refreshToken", "type": "string token, at least 10 characters", "required": true },
    { "case": "login, refresh, reader-login, authorize", "field": "user.token", "type": "compact JWT with three segments; replaced only by SHA-256 fingerprint", "required": true },
    { "case": "login, refresh, reader-login, authorize", "field": "user.lastSeen", "type": "number or null", "required": true },
    { "case": "login, refresh, reader-login, authorize", "field": "serverSettings.backupPath", "type": "string ending in /metadata/backups", "required": true },
    { "case": "progress-read", "field": "lastUpdate, startedAt, finishedAt", "type": "number or null", "required": true },
    { "case": "bookmark-create, bookmark-update, bookmark-read-after-create, bookmark-read-after-delete", "field": "createdAt", "type": "number", "required": true },
    { "case": "book-detail-after-library-scan", "field": "lastScan, updatedAt", "type": "number or null", "required": true },
    { "case": "book-list-after-library-scan", "field": "results[].updatedAt", "type": "number or null", "required": true },
    { "case": "book-detail-after-library-scan", "field": "birthtimeMs, ctimeMs, mtimeMs, libraryFiles[].addedAt, libraryFiles[].updatedAt, libraryFiles[].metadata.{birthtimeMs,ctimeMs,mtimeMs}", "type": "number or null", "required": true },
    { "case": "book-list-after-library-scan", "field": "results[].birthtimeMs, results[].ctimeMs, results[].mtimeMs", "type": "number or null", "required": true },
    { "case": "book-detail-after-library-scan, book-list-after-library-scan", "field": "ino, libraryFiles[].ino, results[].ino", "type": "numeric string inode from separately copied fixture files", "required": true },
    { "case": "collection-create, collection-read, collection-update, collection-list, playlist-create, playlist-read, playlist-update, playlist-list", "field": "entity.id", "type": "UUID", "required": true },
    { "case": "collection-create, collection-read, collection-update, collection-list, playlist-create, playlist-read, playlist-update, playlist-list", "field": "entity.createdAt, entity.lastUpdate", "type": "number or null", "required": true },
    { "case": "cover-upload, cover-url-upload", "field": "cover", "type": "absolute path rooted under the side-specific fixture metadata directory; suffix preserved", "required": true },
    { "case": "cover-raw, cover-cache-default, cover-cache-jpeg-size, cover-cache-png-size, cover-cache-webp-size, cover-cache-ts-header", "field": "response body and content/cache headers", "type": "exact bytes and exact present headers", "required": true },
    { "case": "session-list, session-list-after-delete", "field": "sessions[].id", "type": "UUID", "required": "when non-empty" },
    { "case": "session-list, session-list-after-delete", "field": "sessions[].createdAt, sessions[].updatedAt", "type": "number or null", "required": "when non-empty" },
    { "case": "library-create, library-read, library-update, library-list-after-create, library-list-after-delete", "field": "library.id, folders[].id, folders[].libraryId", "type": "UUID; folder/library relationships preserved", "required": true },
    { "case": "library-create, library-read, library-update, library-list-after-create, library-list-after-delete", "field": "library.createdAt, library.lastUpdate", "type": "number or null", "required": true },
    { "case": "user-create, user-read, user-update, user-list, user-list-after-delete, user-create-forbidden", "field": "parity-user.id", "type": "UUID", "required": true },
    { "case": "user-create, user-read, user-update, user-list, user-list-after-delete", "field": "parity-user.token", "type": "compact JWT; replaced only for the generated parity user", "required": "true when returned" },
    { "case": "user-create-forbidden", "field": "user.token", "type": "compact JWT replaced with <per-side-jwt> because independent servers use distinct signing keys; createdAt, updatedAt and lastSeen are dynamic", "required": "when returned" },
    { "case": "playlist-empty-items", "field": "id, createdAt, lastUpdate", "type": "UUID and dynamic entity timestamps", "required": true },
    { "case": "api-key-create, api-key-list, api-key-update", "field": "apiKey.id, apiKey.userId", "type": "UUID; parity user relationship preserved", "required": true },
    { "case": "api-key-create, api-key-list, api-key-update", "field": "apiKey.apiKey", "type": "string token of at least 10 characters", "required": "true only on create response" },
    { "case": "api-key-create, api-key-list, api-key-update", "field": "createdAt, updatedAt, expiresAt", "type": "ISO date string or null", "required": true },
    { "case": "playback-session", "field": "id", "type": "UUID", "required": true },
    { "case": "playback-session", "field": "deviceInfo.id", "type": "UUID", "required": true },
    { "case": "playback-session", "field": "startedAt, updatedAt", "type": "number or null", "required": true },
    { "case": "playback-session", "field": "audioTracks[].contentUrl", "type": "string containing the returned session UUID", "required": true },
    { "case": "libraries, libraries-unauthorized", "field": "libraries[].folders[].fullPath", "type": "absolute path rooted under the side-specific fixture media directory; suffix preserved", "required": true },
    { "case": "book-library-items, book-library-items-minified, book-item-detail, book-list-after-library-scan, book-detail-after-library-scan", "field": "path, coverPath, imagePath", "type": "null or absolute path rooted under the side-specific fixture media directory; suffix preserved", "required": "true when non-null" },
    { "case": "collection-create, collection-read, collection-update, collection-list, playlist-create, playlist-read, playlist-update, playlist-list", "field": "path, coverPath, imagePath", "type": "null or absolute path rooted under the side-specific fixture media directory; suffix preserved", "required": "true when non-null" },
    { "case": "socket-connect-prefixed, socket-connect-legacy", "field": "init payload", "type": "all deterministic values compared without normalization", "required": true }
  ]
}
