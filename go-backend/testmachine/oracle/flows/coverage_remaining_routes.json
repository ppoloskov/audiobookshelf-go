{
  "name": "coverage-remaining-routes",
  "steps": [
    {"name": "ping-health", "method": "GET", "path": "/ping", "expect_status": 200},
    {"name": "healthcheck-ok", "method": "GET", "path": "/healthcheck", "expect_status": 200},
    {"name": "get-saga1-for-file-download", "method": "GET", "path": "/api/items/{{saga1}}", "role": "root", "expect_status": 200, "capture": {"audio_ino": "media.audioFiles.0.ino"}},
    {"name": "download-saga1-audio-file", "method": "GET", "path": "/api/items/{{saga1}}/file/{{audio_ino}}/download", "role": "listener", "expect_status": 200},
    {"name": "get-saga1-cover-default", "method": "GET", "path": "/api/items/{{saga1}}/cover", "role": "listener", "expect_status": 200},
    {"name": "get-saga1-metadata-object", "method": "GET", "path": "/api/items/{{saga1}}/metadata-object", "role": "root", "expect_status": 200},
    {"name": "get-ebook-for-status-toggle", "method": "GET", "path": "/api/items/{{ebook}}", "role": "root", "expect_status": 200, "capture": {"ebook_ino": "media.ebookFile.ino"}},
    {"name": "get-ebook-primary", "method": "GET", "path": "/api/items/{{ebook}}/ebook", "role": "listener", "expect_status": 200},
    {"name": "get-ebook-by-ino", "method": "GET", "path": "/api/items/{{ebook}}/ebook/{{ebook_ino}}", "role": "listener", "expect_status": 200},
    {"name": "toggle-ebook-to-supplementary", "method": "PATCH", "path": "/api/items/{{ebook}}/ebook/{{ebook_ino}}/status", "role": "root", "expect_status": 200, "check_db": true, "check_sockets": true},
    {"name": "toggle-ebook-back-to-primary", "method": "PATCH", "path": "/api/items/{{ebook}}/ebook/{{ebook_ino}}/status", "role": "root", "expect_status": 200, "check_db": true, "check_sockets": true},
    {"name": "stub-author-png", "kind": "stub_route", "path": "/author.png", "stub_status": 200, "stub_content_type": "image/png", "stub_body_base64": "iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAIAAACQd1PeAAAADElEQVR4nGP4z8AAAAMBAQDJ/pLvAAAAAElFTkSuQmCC"},
    {
      "name": "upload-author1-image-from-url",
      "method": "POST",
      "path": "/api/authors/{{author1}}/image",
      "role": "root",
      "body": {"url": "{{stub_http}}/author.png"},
      "expect_status": 200,
      "check_db": true,
      "check_sockets": true,
      "check_stubs": true
    },
    {"name": "get-author1-image-default", "method": "GET", "path": "/api/authors/{{author1}}/image", "expect_status": 200},
    {"name": "get-author1-image-jpeg-100", "method": "GET", "path": "/api/authors/{{author1}}/image", "query": {"format": "jpeg", "width": "100"}, "expect_status": 200},
    {"name": "get-author1-image-raw", "method": "GET", "path": "/api/authors/{{author1}}/image", "query": {"raw": "1"}, "expect_status": 200},
    {"name": "delete-author1-image", "method": "DELETE", "path": "/api/authors/{{author1}}/image", "role": "root", "expect_status": 200, "check_db": true, "check_sockets": true},
    {"name": "match-author1-empty-query", "method": "POST", "path": "/api/authors/{{author1}}/match", "role": "root", "body": {"q": ""}, "expect_status": 404},
    {"name": "me-bookmarks-for-saga1", "method": "GET", "path": "/api/me/bookmarks/{{saga1}}", "role": "listener", "expect_status": 200},
    {"name": "me-item-listening-sessions-book", "method": "GET", "path": "/api/me/item/listening-sessions/{{saga1}}", "role": "listener", "expect_status": 200},
    {"name": "me-item-listening-sessions-episode", "method": "GET", "path": "/api/me/item/listening-sessions/{{podcast}}/{{ep1}}", "role": "listener", "expect_status": 200},
    {"name": "me-stats-year-2026", "method": "GET", "path": "/api/me/stats/year/2026", "role": "listener", "expect_status": 200},
    {"name": "me-listening-stats", "method": "GET", "path": "/api/me/listening-stats", "role": "listener", "expect_status": 200},
    {
      "name": "me-update-ereader-devices",
      "method": "POST",
      "path": "/api/me/ereader-devices",
      "role": "listener",
      "body": {"ereaderDevices": [{"name": "Listener Kindle", "email": "listener-kindle@example.test", "availabilityOption": "specificUsers", "users": ["{{listener}}"]}]},
      "expect_status": 200,
      "check_db": true,
      "check_sockets": true
    },
    {"name": "users-listener-listening-stats", "method": "GET", "path": "/api/users/{{listener}}/listening-stats", "role": "root", "expect_status": 200},
    {
      "name": "create-temp-user-for-me-ops",
      "method": "POST",
      "path": "/api/users",
      "role": "root",
      "body": {
        "username": "oracle-rem-user",
        "password": "rem-password-1",
        "type": "user",
        "isActive": true,
        "permissions": {"download": true, "update": false, "delete": false, "upload": false, "accessAllLibraries": true, "accessAllTags": true, "accessExplicitContent": true}
      },
      "expect_status": 200,
      "capture": {"temp_u": "user.id"},
      "check_db": true
    },
    {
      "name": "login-temp-user",
      "method": "POST",
      "path": "/login",
      "header": {"x-return-tokens": "true"},
      "body": {"username": "oracle-rem-user", "password": "rem-password-1"},
      "expect_status": 200,
      "capture": {"temp_u_acc": "user.accessToken", "temp_u_ref": "user.refreshToken"}
    },
    {"name": "me-sessions-list", "method": "GET", "path": "/api/me/sessions", "role": "{{temp_u_acc}}", "header": {"x-refresh-token": "{{temp_u_ref}}"}, "expect_status": 200},
    {
      "name": "me-patch-password",
      "method": "PATCH",
      "path": "/api/me/password",
      "role": "{{temp_u_acc}}",
      "header": {"x-refresh-token": "{{temp_u_ref}}"},
      "body": {"password": "rem-password-1", "newPassword": "rem-password-2"},
      "expect_status": 200,
      "capture": {"temp_u_acc2": "user.accessToken", "temp_u_ref2": "user.refreshToken"},
      "check_db": true
    },
    {
      "name": "me-sessions-list-after-pw-change",
      "method": "GET",
      "path": "/api/me/sessions",
      "role": "{{temp_u_acc2}}",
      "header": {"x-refresh-token": "{{temp_u_ref2}}"},
      "expect_status": 200,
      "capture": {"temp_auth_sess": "sessions.0.id"}
    },
    {"name": "me-sessions-delete", "method": "DELETE", "path": "/api/me/sessions/{{temp_auth_sess}}", "role": "{{temp_u_acc2}}", "expect_status": 200, "check_db": true},
    {"name": "users-openid-unlink-temp", "method": "PATCH", "path": "/api/users/{{temp_u}}/openid-unlink", "role": "root", "expect_status": 200, "check_db": true},
    {"name": "delete-temp-user", "method": "DELETE", "path": "/api/users/{{temp_u}}", "role": "root", "expect_status": 200, "check_db": true},
    {"name": "library-collections-get", "method": "GET", "path": "/api/libraries/{{library}}/collections", "role": "root", "expect_status": 200},
    {"name": "library-playlists-get", "method": "GET", "path": "/api/libraries/{{library}}/playlists", "role": "listener", "expect_status": 200},
    {"name": "library-podcast-titles-get", "method": "GET", "path": "/api/libraries/{{podcastLibrary}}/podcast-titles", "role": "root", "expect_status": 200},
    {"name": "library-issues-delete", "method": "DELETE", "path": "/api/libraries/{{library}}/issues", "role": "root", "expect_status": 200},
    {
      "name": "libraries-order-post",
      "method": "POST",
      "path": "/api/libraries/order",
      "role": "root",
      "body": [{"id": "{{podcastLibrary}}", "newOrder": 1}, {"id": "{{library}}", "newOrder": 2}],
      "expect_status": 200,
      "check_db": true
    },
    {"name": "stub-apprise-rem", "kind": "stub_route", "path": "/apprise", "stub_status": 200, "stub_content_type": "application/json", "stub_body": "{\"ok\":true}"},
    {
      "name": "notifications-patch-apprise",
      "method": "PATCH",
      "path": "/api/notifications",
      "role": "root",
      "body": {"appriseApiUrl": "{{stub_http}}/apprise", "maxFailedAttempts": 5, "maxNotificationQueue": 20},
      "expect_status": 200,
      "check_db": true
    },
    {
      "name": "notifications-create-ontest",
      "method": "POST",
      "path": "/api/notifications",
      "role": "root",
      "body": {"eventName": "onTest", "urls": ["mailto://user:pass@example.com"], "titleTemplate": "Rem Alert", "bodyTemplate": "Rem body", "enabled": true, "type": "info"},
      "expect_status": 200,
      "capture": {"notif_id": "notifications.0.id"},
      "check_db": true
    },
    {"name": "notifications-fire-test-event", "method": "GET", "path": "/api/notifications/test", "role": "root", "expect_status": 200, "check_stubs": true},
    {"name": "notifications-delete-ontest", "method": "DELETE", "path": "/api/notifications/{{notif_id}}", "role": "root", "expect_status": 200, "check_db": true},
    {
      "name": "stub-podcast-search-feed",
      "kind": "stub_route",
      "path": "/pod-rem.xml",
      "stub_status": 200,
      "stub_content_type": "application/xml",
      "stub_body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?><rss version=\"2.0\" xmlns:itunes=\"http://www.itunes.com/dtds/podcast-1.0.dtd\"><channel><title>Fixture Cast</title><description>Fixture feed</description><itunes:author>Fixture Host</itunes:author><item><title>Pilot Episode</title><description>Matched pilot description</description><pubDate>Mon, 01 Jan 2024 00:00:00 GMT</pubDate><guid isPermaLink=\"false\">pilot-ep-1</guid><enclosure url=\"{{stub_http_shared}}/pilot.mp3\" length=\"1024\" type=\"audio/mpeg\"/></item></channel></rss>"
    },
    {"name": "podcast-set-feed-url", "method": "PATCH", "path": "/api/items/{{podcast}}/media", "role": "root", "body": {"metadata": {"feedUrl": "{{stub_http}}/pod-rem.xml"}}, "expect_status": 200, "check_db": true},
    {"name": "podcast-search-episode-pilot", "method": "GET", "path": "/api/podcasts/{{podcast}}/search-episode", "role": "root", "query": {"title": "Pilot"}, "expect_status": 200, "check_stubs": true},
    {"name": "podcast-match-episodes", "method": "POST", "path": "/api/podcasts/{{podcast}}/match-episodes", "role": "root", "expect_status": 200, "check_db": true, "check_stubs": true},
    {"name": "podcast-delete-ep3-soft", "method": "DELETE", "path": "/api/podcasts/{{podcast}}/episode/{{ep3}}", "role": "root", "expect_status": 200, "check_db": true, "check_sockets": true},
    {
      "name": "open-share-for-cover",
      "method": "POST",
      "path": "/api/share/mediaitem",
      "role": "root",
      "body": {"slug": "oracle-rem-share", "expiresAt": 0, "mediaItemType": "book", "mediaItemId": "{{book1}}", "isDownloadable": true},
      "expect_status": 201,
      "capture": {"share_id": "id"},
      "check_db": true,
      "check_sockets": true
    },
    {"name": "get-public-share-init", "method": "GET", "path": "/public/share/oracle-rem-share", "header": {"Cookie": "share_session_id=55555555-5555-4555-8555-555555555555"}, "expect_status": 200},
    {"name": "get-public-share-cover", "method": "GET", "path": "/public/share/oracle-rem-share/cover", "header": {"Cookie": "share_session_id=55555555-5555-4555-8555-555555555555"}, "expect_status": 200},
    {"name": "close-share-for-cover", "method": "DELETE", "path": "/api/share/mediaitem/{{share_id}}", "role": "root", "expect_status": 204, "check_db": true, "check_sockets": true},
    {
      "name": "open-feed-for-cover-and-stream",
      "method": "POST",
      "path": "/api/feeds/item/{{saga1}}/open",
      "role": "root",
      "body": {"serverAddress": "http://127.0.0.1:8080", "slug": "oracle-rem-feed"},
      "expect_status": 200,
      "capture": {"feed_id": "feed.id", "feed_ep_id": "feed.episodes.0.id"},
      "check_db": true,
      "check_sockets": true
    },
    {"name": "get-feeds-list", "method": "GET", "path": "/api/feeds", "role": "root", "expect_status": 200},
    {"name": "get-feed-xml", "method": "GET", "path": "/feed/oracle-rem-feed", "expect_status": 200},
    {"name": "get-feed-cover", "method": "GET", "path": "/feed/oracle-rem-feed/cover.jpg", "expect_status": 200},
    {"name": "get-feed-item-range", "method": "GET", "path": "/feed/oracle-rem-feed/item/{{feed_ep_id}}/media.mp3", "header": {"Range": "bytes=0-63"}, "expect_status": 206},
    {"name": "close-feed-for-cover-and-stream", "method": "POST", "path": "/api/feeds/{{feed_id}}/close", "role": "root", "expect_status": 200, "check_db": true, "check_sockets": true},
    {
      "name": "emails-patch-smtp-settings",
      "method": "PATCH",
      "path": "/api/emails/settings",
      "role": "root",
      "body": {"host": "{{stub_smtp_host}}", "port": "{{stub_smtp_port}}", "secure": false, "rejectUnauthorized": false, "fromAddress": "abs@example.test", "testAddress": "test@example.test"},
      "expect_status": 200,
      "check_db": true
    },
    {
      "name": "emails-configure-ereader-device",
      "method": "POST",
      "path": "/api/emails/ereader-devices",
      "role": "root",
      "body": {"ereaderDevices": [{"name": "Kindle Rem", "email": "kindle-rem@example.test", "availabilityOption": "adminOrUp", "users": []}]},
      "expect_status": 200,
      "check_db": true,
      "check_sockets": true
    },
    {"name": "emails-send-ebook-to-device", "method": "POST", "path": "/api/emails/send-ebook-to-device", "role": "root", "body": {"libraryItemId": "{{ebook}}", "deviceName": "Kindle Rem"}, "expect_status": 200, "check_stubs": true},
    {"name": "get-fixture-playlist", "method": "GET", "path": "/api/playlists/{{playlist}}", "role": "listener", "expect_status": 200},
    {"name": "list-all-collections", "method": "GET", "path": "/api/collections", "role": "root", "expect_status": 200},
    {"name": "me-all-progress", "method": "GET", "path": "/api/me/progress", "role": "listener", "expect_status": 200},
    {"name": "items-batch-scan", "method": "POST", "path": "/api/items/batch/scan", "role": "root", "body": {"libraryItemIds": ["{{saga1}}"]}, "expect_status": 200},
    {"name": "saga2-add-temp-series", "method": "PATCH", "path": "/api/items/{{saga2}}/media", "role": "root", "body": {"metadata": {"series": [{"name": "Oracle Brand New Series", "sequence": "1"}]}}, "expect_status": 200, "check_sockets": true},
    {"name": "saga2-clear-temp-series", "method": "PATCH", "path": "/api/items/{{saga2}}/media", "role": "root", "body": {"metadata": {"series": []}}, "expect_status": 200, "check_sockets": true},
    {
      "name": "create-temp-playlist-for-remove-item",
      "method": "POST",
      "path": "/api/playlists",
      "role": "root",
      "body": {"libraryId": "{{library}}", "name": "Oracle Rem Playlist", "items": [{"libraryItemId": "{{saga1}}"}, {"libraryItemId": "{{saga2}}"}]},
      "expect_status": 200,
      "capture": {"new_pl": "id"},
      "check_db": true,
      "check_sockets": true
    },
    {"name": "playlist-remove-single-item", "method": "DELETE", "path": "/api/playlists/{{new_pl}}/item/{{saga1}}", "role": "root", "expect_status": 200, "check_db": true, "check_sockets": true},
    {"name": "playlist-delete-temp", "method": "DELETE", "path": "/api/playlists/{{new_pl}}", "role": "root", "expect_status": 200, "check_db": true, "check_sockets": true},
    {
      "name": "create-local-session-for-batch-delete",
      "method": "POST",
      "path": "/api/session/local",
      "role": "listener",
      "body": {
        "id": "77777777-7777-4777-8777-777777777777",
        "libraryItemId": "{{novel}}",
        "mediaType": "book",
        "playMethod": 0,
        "mediaPlayer": "exo-player",
        "timeListening": 10,
        "startTime": 0,
        "currentTime": 10,
        "duration": 180,
        "startedAt": 1800000300000,
        "updatedAt": 1800000310000,
        "deviceInfo": {"clientName": "OracleOffline", "clientVersion": "1.0", "deviceId": "oracle-offline-rem-1"}
      },
      "expect_status": 200,
      "check_db": true
    },
    {"name": "sessions-batch-delete", "method": "POST", "path": "/api/sessions/batch/delete", "role": "root", "body": {"sessions": ["77777777-7777-4777-8777-777777777777"]}, "expect_status": 200, "check_db": true},
    {"name": "delete-author2-cleanup", "method": "DELETE", "path": "/api/authors/{{author2}}", "role": "root", "expect_status": 200, "check_db": true, "check_sockets": true}
  ]
}
